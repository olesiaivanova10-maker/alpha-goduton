  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "company_id": {
            "type": "string",
            "title": "Company Id"
          },
          "news_title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "News Title"
          },
          "news_body": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 1,
            "title": "News Body"
          },
          "news_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "News Id"
          },
          "source_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Name",
            "default": "СМИ"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserRole"
              },
              {
                "type": "null"
              }
            ],
            "default": "CFO"
          }
        },
        "type": "object",
        "required": [
          "company_id",
          "news_title",
          "news_body"
        ],
        "title": "AnalyzeRequest"
      },
      "CompanyContext": {
        "properties": {
          "company_id": {
            "type": "string",
            "title": "Company Id"
          },
          "group_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Id"
          },
          "industry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Industry"
          },
          "organization": {
            "additionalProperties": true,
            "type": "object",
            "title": "Organization"
          },
          "location": {
            "additionalProperties": true,
            "type": "object",
            "title": "Location"
          },
          "scale": {
            "additionalProperties": true,
            "type": "object",
            "title": "Scale"
          },
          "bank_products": {
            "additionalProperties": true,
            "type": "object",
            "title": "Bank Products"
          },
          "foreign_trade": {
            "additionalProperties": true,
            "type": "object",
            "title": "Foreign Trade"
          },
          "group_companies": {
            "items": {
              "type": "string"
