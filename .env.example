REQUESTS_PER_MINUTE=20
MAX_QUEUE_SIZE=100
MODEL_CONCURRENCY=2
MODEL_DAILY_TOKEN_BUDGET=200000
MODEL_DAILY_CALL_LIMIT=100
MODEL_CONTEXT_MAX_CHARS=40000
MODEL_PRICES_JSON={}
RSS_REFRESH_SECONDS=900
RAG_MODE=lexical
PDF_DIR=data_alfbnk
